  "protocols": [
    {
      "name": "MCP",
      "aliases": ["modelcontextprotocol", "Model Context Protocol"],
      "repos": ["modelcontextprotocol/specification", "modelcontextprotocol/servers"],
      "docs": ["https://modelcontextprotocol.io/"],
      "onCard": true
    },
    {
      "name": "A2A",
      "aliases": ["Agent2Agent", "a2a-protocol"],
      "repos": ["a2aproject/A2A"],
      "docs": ["https://a2a-protocol.org/"],
      "onCard": true
    }
  ],
  "searchQueries": [
    "AI agent framework stars:>500",
    "multi-agent orchestration library stars:>300",
    "\"agent sdk\" stars:>200",
    "Model Context Protocol server stars:>200"
  ],
  "ignoreRepos": [
    "langchain-ai/langchain",
    "langchain-ai/langchainjs",
    "obra/superpowers",
    "microsoft/autogen"
  ]
}
