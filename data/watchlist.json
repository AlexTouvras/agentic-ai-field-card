      "docs": ["https://langchain-ai.github.io/langgraph/"],
      "onCard": true,
      "constraint": "control"
    },
    {
      "name": "CrewAI",
      "repos": ["crewAIInc/crewAI"],
      "docs": ["https://docs.crewai.com/"],
      "onCard": true,
      "constraint": "speed"
    },
    {
      "name": "LlamaIndex",
